{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "play-together-game-server",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}